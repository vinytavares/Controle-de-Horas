# ─── MongoDB Atlas ───────────────────────────────────────
# Connection string do seu cluster (Atlas → Connect → Drivers)
# Substitua <usuario>, <senha> e <cluster> pelos seus valores.
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nome do banco de dados (opcional, padrão: controle_horas)
MONGODB_DB=controle_horas

# ─── Segurança ───────────────────────────────────────────
# Segredo para assinar os tokens JWT. Use uma string longa e aleatória.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cole-aqui-um-segredo-longo-e-aleatorio
